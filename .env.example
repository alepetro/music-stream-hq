# Telegram Bot Token (from @BotFather)
TELEGRAM_TOKEN=your_token_here

# PostgreSQL connection string (optional, for user/premium persistence across deploys)
# On Railway: set this in the Variables tab by adding a Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Public base URL (for inline audio placeholder, optional)
PUBLIC_BASE_URL=https://your-railway-domain.up.railway.app
